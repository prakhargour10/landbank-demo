{
  "manifest_version": "1.0",
  "connector": "landbank_msme_demo_data",
  "agent": "MSME Application Agent",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key",
    "value_ref": "secret://landbank/lbk_agent_application"
  },
  "tools": [
    {
      "name": "getCustomer",
      "method": "GET",
      "path": "/api/v1/customers/{customer_id}",
      "permission": "read",
      "description": "Profile, KYC status, vintage, RM."
    },
    {
      "name": "getCustomer360",
      "method": "GET",
      "path": "/api/v1/customers/{customer_id}/360",
      "permission": "read",
      "description": "Everything about a customer in one call (loans, health, signals, open work)."
    },
    {
      "name": "getAccounts",
      "method": "GET",
      "path": "/api/v1/customers/{customer_id}/accounts",
      "permission": "read",
      "description": "Deposit accounts and balances."
    },
    {
      "name": "getProductHoldings",
      "method": "GET",
      "path": "/api/v1/customers/{customer_id}/products",
      "permission": "read",
      "description": "Products the customer already holds."
    },
    {
      "name": "checkEligibility",
      "method": "POST",
      "path": "/api/v1/customers/{customer_id}/eligibility-check",
      "permission": "read",
      "description": "Indicative eligibility and max amount from data the bank already holds (not an approval)."
    },
    {
      "name": "requestConsent",
      "method": "POST",
      "path": "/api/v1/consents",
      "permission": "write",
      "description": "Ask the MSME for read-only, time-bound data consent."
    },
    {
      "name": "getConsent",
      "method": "GET",
      "path": "/api/v1/consents/{consent_id}",
      "permission": "read",
      "description": "Check whether consent was granted."
    },
    {
      "name": "createApplication",
      "method": "POST",
      "path": "/api/v1/applications",
      "permission": "write",
      "description": "Start a loan application (amount in full pesos)."
    },
    {
      "name": "listApplications",
      "method": "GET",
      "path": "/api/v1/applications",
      "permission": "read",
      "description": "List applications by status or customer."
    },
    {
      "name": "getApplication",
      "method": "GET",
      "path": "/api/v1/applications/{application_id}",
      "permission": "read",
      "description": "Application with consent, documents and timeline."
    },
    {
      "name": "listDocuments",
      "method": "GET",
      "path": "/api/v1/applications/{application_id}/documents",
      "permission": "read",
      "description": "Document checklist with status and issues."
    },
    {
      "name": "fetchDocuments",
      "method": "POST",
      "path": "/api/v1/applications/{application_id}/documents/fetch",
      "permission": "write",
      "description": "Pull bank statements, VAT returns, credit report and registration via consent."
    },
    {
      "name": "validateDocuments",
      "method": "POST",
      "path": "/api/v1/applications/{application_id}/documents/validate",
      "permission": "write",
      "description": "Validate documents; find missing pages; cross-check declared sales vs bank receipts."
    },
    {
      "name": "requestDocument",
      "method": "POST",
      "path": "/api/v1/applications/{application_id}/documents/request",
      "permission": "write",
      "description": "Ask the MSME for a missing or corrected document."
    },
    {
      "name": "getDocument",
      "method": "GET",
      "path": "/api/v1/documents/{document_id}",
      "permission": "read",
      "description": "Document metadata, issues and extracted values."
    },
    {
      "name": "downloadDocument",
      "method": "GET",
      "path": "/api/v1/documents/{document_id}/file",
      "permission": "read",
      "description": "Document as PDF (for OCR / reading)."
    },
    {
      "name": "createRMTask",
      "method": "POST",
      "path": "/api/v1/rm-tasks",
      "permission": "write",
      "description": "Create a task for the customer's RM (risk outreach, document follow-up, growth)."
    },
    {
      "name": "getReferenceData",
      "method": "GET",
      "path": "/api/v1/reference/{kind}",
      "permission": "read",
      "description": "Products, early-warning rules, document checklist, RMs, event types."
    }
  ],
  "denied_tools": [
    "activateLoan",
    "applyDemoStress",
    "createWebhookSubscription",
    "declineConsent",
    "deleteWebhookSubscription",
    "getAuditTrail",
    "grantConsent",
    "listWebhookSubscriptions",
    "openCreditCase",
    "recordHumanDecision",
    "resetDemoData",
    "submitApplication",
    "updateRMLead",
    "updateRMTask",
    "updateRiskAlert",
    "uploadDocument"
  ],
  "human_approval_required_for": [
    "recordHumanDecision",
    "activateLoan"
  ]
}